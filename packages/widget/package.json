{
  "name": "@kletia/widget",
  "version": "0.1.0",
  "description": "Embeddable React widget for Kletia cross-network intents: plan, review and execute with your users' EVM and Solana wallets.",
  "license": "MIT",
  "author": "Kletia",
  "homepage": "https://github.com/furkan3152/Kletia/tree/main/packages/widget#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkan3152/Kletia.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/furkan3152/Kletia/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./review": {
      "types": "./dist/review.d.ts",
      "import": "./dist/review.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@kletia/core": "0.1.0",
    "@kletia/sdk": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "typescript": "5.9.3"
  },
  "keywords": [
    "kletia",
    "intents",
    "widget",
    "react",
    "solana",
    "evm"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
