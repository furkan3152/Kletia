    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smart-account-kit": "0.6.2",
    "snarkjs": "0.7.6",
    "stellar-private-payments": "0.1.0-alpha.1",
    "stellar-sdk-16": "npm:@stellar/stellar-sdk@16.0.1",
    "viem": "^2.55.8",
    "wagmi": "^2.19.5",
    "ws": "8.21.3",
    "zustand": "^5.0.14"
