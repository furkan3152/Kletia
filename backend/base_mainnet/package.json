{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "Kletia Core Engine",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pretest": "hardhat compile --config hardhat.config.cjs",
    "test": "vitest run",
    "test:network": "tsx src/tests/network-contract.smoke.ts",
    "verify:base-registry": "tsx src/scripts/verifyBaseRegistry.ts",
    "evidence:launch-factory-v2": "tsx src/scripts/exportLaunchFactoryV2Evidence.ts",
    "plan:fee-router-cleanup": "tsx src/scripts/planFeeRouterCleanup.ts",
    "release:preflight": "npm run typecheck && npm run test:network && npm run verify:base-registry",
    "typecheck": "tsc -p tsconfig.api.json"
  },
  "keywords": [
    "kletia",
    "web3",
    "intent",
    "engine"
  ],
  "author": "Kletia CEO",
  "license": "ISC",
  "dependencies": {
    "@coinbase/cdp-sdk": "1.54.0",
    "@scure/bip39": "1.6.0",
    "@webacy-xyz/sdk": "^1.8.0",
    "@x402/core": "2.20.0",
    "@x402/evm": "2.20.0",
    "@x402/express": "2.20.0",
    "@x402/extensions": "2.20.0",
    "@x402/svm": "2.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "viem": "^2.55.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-mocha": "^3.0.21",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.28.6",
    "mocha": "^11.7.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "axios": "1.18.1",
    "form-data": "4.0.6"
  }
}
