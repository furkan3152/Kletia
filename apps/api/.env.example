PORT=3001
# Additional browser origins, comma-separated. Built-in production/local
# origins remain enabled.
CORS_ORIGINS=

# Network providers. Never reuse a mainnet signer/private key for Arc testnet.
BASE_RPC_URL=https://your-base-mainnet-rpc.example
ARC_RPC_URL=https://rpc.testnet.arc.network
ARBITRUM_RPC_URL=https://your-arbitrum-mainnet-rpc.example
# Public Beta release switch. The API attests chainId 42161 before accepting it.
ARBITRUM_MVP_ENABLED=false
# At least 32 random characters; server-only HMAC key for sealed WorkflowPlanV1 state.
WORKFLOW_SIGNING_SECRET=
# Arc Vault V2 is the active new-deposit route. The legacy contract remains
# available only for explicit self-custodial migration withdrawals.
ARC_VAULT_EXECUTION_MODE=vault_v2
ARC_VAULT_V2_ADDRESS=0xBe385e3520C20D44697CC1bEEDc9DF759C3A184d
ARC_VAULT_V2_RUNTIME_CODEHASH=0xa6cb476a1243a6d9bc71909a5774d1340061e91bcb47cd8aea3df1f5444bec1f
CDP_NODE_API_KEY=
ALCHEMY_API_KEY=

# Intent parsing and optional live data providers
OPENROUTER_API_KEY=
ALLORA_API_KEY=
WEBACY_API_KEY=
# Required credentials for the Across production API used by Base bridge routes.
ACROSS_API_KEY=
ACROSS_INTEGRATOR_ID=
# Maximum accepted live relay fee in basis points (default 300 = 3%).
ACROSS_MAX_RELAY_FEE_BPS=300

# Base-only CDP configuration
# Official CDP SDK credentials used by the Base mainnet x402 facilitator.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Legacy ES256 key pair used only by the existing Coinbase Onramp token route.
# The official CDP x402 client also accepts this existing pair as a backwards-
# compatible fallback when ID/SECRET above are not configured.
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
NETWORK_ID=base-mainnet
# Optional explicit Coinbase Base paymaster endpoint. When omitted,
# CDP_API_KEY_ID is used to construct the canonical endpoint.
CDP_PAYMASTER_URL=
# Required. The proxy injects this server-owned policy into every request.
# Configure contract/method allowlists, per-user limits and global spend caps
# in CDP Portal before enabling sponsorship.
CDP_PAYMASTER_POLICY_ID=
# Enable only after the server-owned CDP policy above is active and reviewed.
PAYMASTER_PROXY_ENABLED=false

# Number of trusted reverse-proxy hops. Use 0 on localhost and the exact
# platform hop count in production so IP limits cannot be spoofed.
TRUST_PROXY_HOPS=0

# Base swap execution boundary. This verified V2 deployment is owned directly
# by the existing 2-of-2 Governance Safe; it has no Timelock dependency.
# `intent_v2` never falls back to the legacy router when either field below is
# absent, stale or inconsistent with live Base bytecode.
BASE_SWAP_EXECUTION_MODE=intent_v2
KLETIA_INTENT_ROUTER_V2_ADDRESS=0xf9BaA05c71c2078A43f6831Eca88220b42932413
# Single-line JSON generated from the exact verified deployment. Address,
# runtime-codehash, adapter/factory/WETH identity and observed-block fields are
# mandatory; do not populate this with placeholder or test data.
KLETIA_INTENT_ROUTER_V2_EVIDENCE_JSON={"schemaVersion":"kletia_base_intent_v2_deployment_v1","validationStatus":"validated","chainId":8453,"observedAtBlock":"49936501","router":"0xf9BaA05c71c2078A43f6831Eca88220b42932413","routerCodehash":"0x9341d0e8f68d7de4273a47b6f495f4b99335fa9d851bafa3204a91dc3ae2fb52","wrappedNative":"0x4200000000000000000000000000000000000006","wrappedNativeCodehash":"0x8a3a1f6a9f9dce633117adee5b458245835a8645a8c8726a26382a4622508b1c","feeBps":10,"adapters":[{"kind":"uniswap_v2_compatible","reviewStatus":"reviewed","protocolId":"uniswap","enabled":true,"adapter":"0xb21C455ceE9ECb4BD0cf19A88d771065db45592b","target":"0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24","spender":"0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24","factory":"0x8909Dc15e40173Ff4699343b6eB8132c65e18eC6","adapterCodehash":"0x0fb7c899f3f97856ee6a83f8e7eb5ede10c341f52e64e92658b35471d3a1dbd7","targetCodehash":"0xec2a9bc649a4a1f23eee18c570628b28c03c665cdd7ebbdb3c46a6c4007959c1","spenderCodehash":"0xec2a9bc649a4a1f23eee18c570628b28c03c665cdd7ebbdb3c46a6c4007959c1","factoryCodehash":"0xbab145d02e7005f0d84c6c1639d39b799b0ea16df99ebbdaf5a14d9da820b4e0","adapterConfigurationHash":"0xfbaf94530df666febfb537d12153342f741a4786b39a99cafd708e12a4de6d36","adapterConfigHash":"0x56c6c7092dc5af58ddc28ad856ae4cd369b41960ff6d5f5d3a73fa34a6f3c6ad"}]}

# Base token deployment cutover is independent from the swap-router mode.
# The strict backend and browser bindings support this verified deployment.
# Production requires the mode explicitly and never falls back from a malformed
# launch_v2 configuration.
BASE_TOKEN_DEPLOYMENT_MODE=launch_v2
KLETIA_LAUNCH_FACTORY_V2_ADDRESS=0x1D62Ac5e19af7688EbC57f262bbB9959dd78e043
# Public, non-secret deployment identity. Runtime reads re-check chainId,
# bytecode, 2-of-2 Safe owner, Treasury Safe, pending treasury and every fee/supply
# cap at one pinned Base block before compiling a deployToken transaction.
KLETIA_LAUNCH_FACTORY_V2_EVIDENCE_JSON={"schemaVersion":"kletia_launch_factory_v2_direct_safe_deployment_v2","validationStatus":"validated","chainId":8453,"observedAtBlock":"49936548","factory":"0x1D62Ac5e19af7688EbC57f262bbB9959dd78e043","factoryCodehash":"0xa28d7ef44ecff154d4b24a2f362868bf29e8a9ca7f172d8b0e3cad2b5fc80e81","ownerAuthority":"0x84f19Fdfd8C50C6349BFe86Cd90BE131387ab47D","ownerAuthorityCodehash":"0xd7d408ebcd99b2b70be43e20253d6d92a8ea8fab29bd3be7f55b10032331fb4c","ownerAuthorityKind":"safe_2_of_2","treasurySafe":"0x64261D1AC0133FB1BB2153e1dCa7B081cd9d05fC","treasurySafeCodehash":"0xd7d408ebcd99b2b70be43e20253d6d92a8ea8fab29bd3be7f55b10032331fb4c","pendingTreasury":"0x0000000000000000000000000000000000000000","factoryFeeCap":"10000000000000000","maxTokenSupply":"1000000000000000000000000000000000000","maxNameBytes":"64","maxSymbolBytes":"16"}

# Base x402 fee destinations
KLETIA_FEE_RECIPIENT=
X402_TREASURY_ADDRESS=
X402_DEFAULT_PRICE_USDC=0.01
# Maximum human-readable Base USDC amount accepted by any buyer-side intent.
X402_BUYER_MAX_PAYMENT_USDC=1
# Verified X402Factory deployment boundary and maximum per-call price (100 USDC).
X402_MAX_PRICE_ATOMIC=100000000
# Base-only, read-only supplemental claim registry. Coinbase CDP Bazaar remains
# the canonical x402 discovery source; these public identities are re-read and
# exact-codehash checked before any claim proof is reported.
KLETIA_X402_ATTESTATION_REGISTRY_ADDRESS=0xE69DE5A5E92F4a52b15C651C1C1fc0fE36143889
KLETIA_X402_ATTESTATION_OWNER_ADDRESS=0x84f19Fdfd8C50C6349BFe86Cd90BE131387ab47D
KLETIA_V2_GUARDIAN_SAFE=0xCae3520A4348BEB2b74Ef52E8be2dE06f57fC0Bc
