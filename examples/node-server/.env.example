# Copy to .env and fill in; never commit it. A sandbox key (`kletia keys create shop --sandbox`) keeps the example on testnets.
KLETIA_API_KEY=kl_dev_your_key_here
# Signing secret of your webhook, or of `kletia listen` during development.
KLETIA_WEBHOOK_SECRET=whsec_your_secret_here
# Optional: a local Kletia API instead of the hosted one.
# KLETIA_BASE_URL=http://localhost:3000
# Where the shop is paid (Arbitrum Sepolia).
SHOP_PAYOUT_ADDRESS=0x52908400098527886E0F7030069857D2E4169EE7
PORT=3000
