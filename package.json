{
  "name": "kletia",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "22.23.1"
  },
  "workspaces": [
    "packages/core",
    "packages/sdk",
    "packages/widget",
    "packages/embed",
    "packages/cli",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "check:structure": "node tooling/validate-repository.mjs",
    "check:docs": "node tooling/verify-documentation.mjs",
    "check:privacy-egress": "node tooling/verify-privacy-egress-guard.mjs",
    "check:intent-privacy-trace": "node tooling/verify-intent-privacy-trace.mjs",
    "check:intent-schema-planner": "npm run verify:intent-schema-planner -w @kletia/api",
    "check:intent-network-matrix": "npm run verify:intent-network-matrix -w @kletia/api",
    "check:intent-user-journey": "npm run verify:intent-user-journey -w @kletia/web",
    "verify:mvp-live": "npm run verify:mvp-live -w @kletia/api",
    "dev:api": "npm run dev:mvp -w @kletia/api",
    "dev:web": "CHOKIDAR_USEPOLLING=true CHOKIDAR_INTERVAL=1000 npm run dev -w @kletia/web -- --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck:api": "npm run typecheck -w @kletia/api",
    "build:api": "npm run build:packages && npm run build -w @kletia/api",
    "typecheck:web": "npm run typecheck -w @kletia/web",
    "lint:web": "npm run lint -w @kletia/web",
    "build:web": "npm run build:packages && npm run build -w @kletia/web",
    "compile:base": "npm --prefix contracts/base run compile",
    "compile:arc": "npm --prefix contracts/arc run compile",
    "test:contracts": "npm --prefix contracts/base test && npm --prefix contracts/arc test",
    "verify": "npm run check:structure && npm run check:docs && npm run check:privacy-egress && npm run test:packages && npm run check:packages && npm run typecheck:api && npm run test:api && npm run build:api && npm run check:openapi && npm run check:intent-schema-planner && npm run check:intent-network-matrix && npm run check:intent-user-journey && npm run check:intent-privacy-trace && npm run test:web && npm run typecheck:web && npm run lint:web && npm run build:web && npm run compile:base && npm run compile:arc && npm run check:arc-runtime-pins && npm run test:contracts",
    "build:packages": "npm run build -w @kletia/core && npm run build -w @kletia/sdk && npm run build -w @kletia/widget && npm run build -w @kletia/embed && npm run build -w @kletia/cli",
    "test:packages": "npm test -w @kletia/core && npm test -w @kletia/sdk && npm test -w @kletia/widget && npm test -w @kletia/embed && npm test -w @kletia/cli",
    "test:api": "npm test -w @kletia/api",
    "test:web": "node --test apps/web/src/app/pages/embed/__tests__/*.test.mjs apps/web/src/networks/arc/runtime/__tests__/*.test.mjs",
    "start:api": "npm run start -w @kletia/api",
    "postinstall": "npm run build:packages",
    "check:packages": "node tooling/verify-packages.mjs",
    "generate:openapi": "node tooling/export-openapi.mjs && node tooling/generate-collections.mjs",
    "check:openapi": "node tooling/export-openapi.mjs --check && node tooling/generate-collections.mjs --check",
    "lint:openapi": "npx --yes @redocly/cli@2.54.2 lint docs/platform/openapi.json",
    "bump:packages": "node tooling/bump-packages.mjs",
    "check:arc-runtime-pins": "node tooling/generate-arc-runtime-pins.mjs --check",
    "test:e2e": "playwright test --config test/e2e/playwright.config.mjs"
  },
  "overrides": {
    "axios": "1.20.0",
    "hono": "4.13.2",
    "socket.io-parser": "4.2.7",
    "viem": {
      "ws": "8.21.1"
    },
    "underscore": "1.13.8",
    "fast-uri": "4.2.1",
    "form-data": "4.0.6",
    "ip-address": "10.5.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "tsx": {
      "esbuild": "0.28.2"
    },
    "@coinbase/cdp-sdk": "1.56.0",
    "@coral-xyz/anchor": {
      "toml": "4.3.0"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
