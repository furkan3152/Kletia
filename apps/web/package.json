    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "verify:policy-merkle": "tsx scripts/verifyPolicyMerkle.ts",
    "verify:policy-v4": "tsx scripts/verifyPolicyV4.ts",
    "verify:solver-market": "tsx scripts/verifySolverMarket.ts",
    "verify:intent-user-journey": "tsx scripts/verifyIntentUserJourney.ts",
    "verify:stellar-payment-intents": "tsx scripts/verifyStellarPaymentIntents.ts",
    "smoke:stellar-policy-v2-testnet": "node scripts/smokeStellarPolicyV2Testnet.mjs",
    "preview": "vite preview",
    "start": "node scripts/serve-production.mjs"
  },
  "dependencies": {
