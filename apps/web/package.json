    "tailwindcss": "^3.4.19",
    "tsx": "4.21.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "axios": "1.18.1",
    "hono": "4.13.2",
    "socket.io-parser": "4.2.7",
