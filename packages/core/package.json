{
  "name": "@kletia/core",
  "version": "0.1.0",
  "description": "Chain-agnostic intent specification for Kletia: CAIP identities, intent graphs, lifecycle, events and webhook signatures.",
  "license": "MIT",
  "author": "Kletia",
  "homepage": "https://github.com/furkan3152/Kletia/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkan3152/Kletia.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/furkan3152/Kletia/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "intents",
    "cross-chain",
    "solana",
    "evm",
    "caip",
    "kletia"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
