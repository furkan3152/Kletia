{
  "name": "@kletia/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Kletia intent API: plan cross-network intents, execute them with EVM and Solana wallets, stream events and verify webhooks.",
  "license": "MIT",
  "author": "Kletia",
  "homepage": "https://github.com/furkan3152/Kletia/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkan3152/Kletia.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/furkan3152/Kletia/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@kletia/core": "0.1.0"
  },
  "keywords": [
    "kletia",
    "intents",
    "sdk",
    "solana",
    "evm",
    "cross-chain"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
