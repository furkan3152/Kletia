{
  "name": "kletia",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "check:structure": "node tooling/validate-repository.mjs",
    "check:stellar-mvp": "node tooling/verify-stellar-mvp.mjs",
    "check:stellar-runtime": "node tooling/verify-stellar-runtime-boundaries.mjs",
    "check:privacy-egress": "node tooling/verify-privacy-egress-guard.mjs",
    "check:privacy-surfaces": "node tooling/verify-privacy-surface-report.mjs",
    "check:stellar-private-payments": "node tooling/verify-stellar-private-payments.mjs",
    "check:intent-privacy-trace": "node tooling/verify-intent-privacy-trace.mjs",
    "check:stellar-policy-contract": "bash tooling/verify-stellar-policy-contract.sh",
    "check:stellar-policy-circuit": "node tooling/verify-stellar-policy-circuit.mjs && npm --prefix circuits/stellar-policy test",
    "check:stellar-policy-workflow": "node tooling/verify-stellar-policy-workflow.mjs",
    "check:workflow-v3": "npm --prefix apps/api run verify:workflow-v3",
    "check:workflow-v3-store": "npm --prefix apps/api run verify:workflow-v3-store",
    "check:workflow-v4": "npm --prefix apps/api run verify:workflow-v4",
    "check:stellar-mpp": "npm --prefix apps/api run verify:stellar-mpp",
    "check:stellar-last-mile": "npm --prefix apps/api run verify:stellar-last-mile",
    "check:stellar-payment-center": "npm --prefix apps/api run verify:stellar-payment-center",
    "check:stellar-reference-anchor-live": "npm --prefix apps/api run verify:stellar-reference-anchor-live",
    "verify:stellar-release-operator-live": "node tooling/verify-stellar-release-operator-live.mjs",
    "verify:stellar-passkey-smoke-live": "node tooling/verify-stellar-passkey-smoke-live.mjs",
    "check:policy-merkle-browser": "npm --prefix apps/web run verify:policy-merkle",
    "check:policy-v4-browser": "npm --prefix apps/web run verify:policy-v4",
    "check:stellar-policy-v2-proof": "node circuits/stellar-policy/verify-proof-v2.mjs",
    "check:solver-market-browser": "npm --prefix apps/web run verify:solver-market",
    "check:intent-user-journey": "npm --prefix apps/web run verify:intent-user-journey",
    "check:stellar-payment-intents": "npm --prefix apps/web run verify:stellar-payment-intents",
    "check:intent-schema-planner": "npm --prefix apps/api run verify:intent-schema-planner",
    "check:intent-network-matrix": "npm --prefix apps/api run verify:intent-network-matrix",
    "check:cctp-v2-binding": "npm --prefix apps/api run verify:cctp-v2-binding",
    "verify:mvp-live": "npm --prefix apps/api run verify:mvp-live",
    "dev:mvp:api": "npm --prefix apps/api run dev:mvp",
    "dev:labs:api": "STELLAR_LABS_ENABLED=true npm --prefix apps/api run dev:mvp",
    "dev:mvp:solver": "npm --prefix apps/api run solver:testnet",
    "dev:mvp:web": "CHOKIDAR_USEPOLLING=true CHOKIDAR_INTERVAL=1000 npm --prefix apps/web run dev -- --host 127.0.0.1 --port 5174 --strictPort",
    "benchmark:solver:testnet": "node tooling/benchmark-testnet-solver.mjs",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "build:api": "npm --prefix apps/api run build",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "lint:web": "npm --prefix apps/web run lint",
    "build:web": "npm --prefix apps/web run build",
    "build:web:labs": "npm --prefix apps/web run build:labs",
    "compile:base": "npm --prefix contracts/base run compile",
    "compile:arc": "npm --prefix contracts/arc run compile",
    "verify": "npm run verify:core",
    "verify:core": "npm run check:structure && npm run check:stellar-last-mile && npm run check:stellar-payment-center && npm run check:stellar-payment-intents && npm run check:privacy-egress && npm run typecheck:api && npm run build:api && npm run check:intent-schema-planner && npm run check:intent-network-matrix && npm run check:cctp-v2-binding && npm run check:intent-user-journey && npm run check:intent-privacy-trace && npm run typecheck:web && npm run lint:web && npm run build:web && npm run compile:base && npm run compile:arc",
    "verify:labs": "npm run check:stellar-mvp && npm run check:stellar-policy-contract && npm run check:stellar-policy-circuit && npm run check:stellar-private-payments && npm run check:workflow-v3 && npm run check:workflow-v3-store && npm run check:workflow-v4 && npm run check:stellar-mpp && npm run check:policy-merkle-browser && npm run check:policy-v4-browser && npm run check:solver-market-browser && npm run check:privacy-surfaces && npm run check:stellar-runtime && npm run check:stellar-policy-workflow && npm run build:web:labs",
    "verify:all": "npm run verify:core && npm run verify:labs"
  },
  "license": "MIT"
}
