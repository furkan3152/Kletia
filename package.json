{
  "name": "kletia",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check:structure": "node tooling/validate-repository.mjs",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "build:api": "npm --prefix apps/api run build",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "lint:web": "npm --prefix apps/web run lint",
    "build:web": "npm --prefix apps/web run build",
    "compile:base": "npm --prefix contracts/base run compile",
    "compile:arc": "npm --prefix contracts/arc run compile",
    "verify": "npm run check:structure && npm run typecheck:api && npm run build:api && npm run typecheck:web && npm run lint:web && npm run build:web && npm run compile:base && npm run compile:arc"
  },
  "license": "MIT"
}
