{
  "name": "@kletia/core",
  "version": "0.1.0",
  "description": "Chain-agnostic intent specification for Kletia: CAIP identities, intent graphs, lifecycle, events and webhook signatures.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "intents",
    "cross-chain",
    "solana",
    "evm",
    "caip",
    "kletia"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
