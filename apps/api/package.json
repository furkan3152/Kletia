{
  "name": "@kletia/api",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "description": "Unified Kletia intent API for Base Mainnet, Arc Testnet, and capability-gated Arbitrum workflows",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "dev:mvp": "node scripts/run-mvp-local.mjs",
    "start": "node dist/index.js",
    "verify:base-registry": "tsx src/scripts/base/verifyProtocolRegistry.ts",
    "evidence:launch-factory-v2": "tsx src/scripts/base/exportLaunchFactoryV2Evidence.ts",
    "plan:fee-router-cleanup": "tsx src/scripts/base/planFeeRouterCleanup.ts",
    "fund:arc-reserves": "tsx src/scripts/arc/fundThirtyDayReserves.ts",
    "release:preflight": "npm run typecheck && npm run build && npm run verify:base-registry",
    "verify:workflow-v3": "tsx src/scripts/verifyWorkflowV3.ts",
    "verify:workflow-v3-store": "tsx src/scripts/verifyWorkflowV3Store.ts",
    "verify:workflow-v4": "tsx src/scripts/verifyWorkflowV4.ts",
    "verify:stellar-mpp": "tsx src/scripts/verifyStellarMpp.ts",
    "verify:stellar-last-mile": "tsx src/scripts/verifyStellarLastMile.ts",
    "verify:stellar-payment-center": "tsx src/scripts/verifyStellarPaymentCenterSep45.ts",
    "verify:stellar-reference-anchor-live": "tsx src/scripts/verifyStellarReferenceAnchorLive.ts",
    "verify:mvp-live": "tsx src/scripts/verifyMvpLive.ts",
    "verify:intent-schema-planner": "tsx src/scripts/verifyIntentSchemaPlanner.ts",
    "verify:intent-network-matrix": "tsx src/scripts/verifyIntentNetworkMatrix.ts",
    "verify:cctp-v2-binding": "tsx src/scripts/verifyCctpV2MessageBinding.ts",
    "solver:testnet": "tsx src/scripts/runTestnetReferenceSolver.ts",
    "typecheck": "tsc -p tsconfig.api.json"
  },
  "keywords": [
    "kletia",
    "web3",
    "intent",
    "engine"
  ],
  "author": "Kletia",
  "license": "MIT",
  "dependencies": {
    "@coinbase/cdp-sdk": "1.54.0",
    "@scure/bip39": "1.6.0",
    "@stellar/mpp": "0.7.1",
    "@stellar/stellar-sdk": "17.0.1",
    "@webacy-xyz/sdk": "^1.8.0",
    "@x402/core": "2.24.0",
    "@x402/evm": "2.24.0",
    "@x402/express": "2.24.0",
    "@x402/extensions": "2.24.0",
    "@x402/svm": "2.24.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mppx": "0.6.29",
    "pg": "^8.16.3",
    "poseidon-lite": "0.3.0",
    "stellar-sdk-16": "npm:@stellar/stellar-sdk@16.0.1",
    "viem": "^2.55.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "axios": "1.18.1",
    "esbuild": "0.28.2",
    "fast-uri": "4.1.2",
    "form-data": "4.0.6",
    "ip-address": "10.5.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
