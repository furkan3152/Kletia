# Unified backend
VITE_BACKEND_URL=https://your-kletia-backend.example
# Set true only for an intentional localhost production preview.
VITE_ALLOW_LOCAL_BACKEND=false

# Wallet connection (required for WalletConnect-based wallets)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# This value is embedded in the browser bundle. Never put a secret CDP Node
# URL/key here; use a public or domain-restricted client RPC. The official
# public URL is rate-limited and is used automatically only in development.
VITE_BASE_RPC_URL=https://your-base-mainnet-rpc.example
VITE_ALLOW_PUBLIC_BASE_RPC_FALLBACK=false
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network

# Required release boundary. Keep this exactly aligned with the backend
# BASE_SWAP_EXECUTION_MODE. Flip both to intent_v2 only after the verified V2
# deployment evidence and coordinated cutover gates are complete.
VITE_BASE_SWAP_EXECUTION_MODE=legacy_v1

# Turn on only when backend PAYMASTER_PROXY_ENABLED=true and the server-owned
# Coinbase Developer Platform policy has exact target/method/spend limits.
VITE_BASE_PAYMASTER_ENABLED=false

# Optional Coinbase OnchainKit/CDP client project identifier
